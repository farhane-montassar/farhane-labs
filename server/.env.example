# Serveur
PORT=5000

# Base de données MongoDB (local ou Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/farhane_labs

# JWT — mets une longue chaîne aléatoire en local
JWT_SECRET=
JWT_EXPIRES=7d

# Stripe (mode test) — requis pour le paiement (/api/payment/*).
# Clé SECRÈTE de test (https://dashboard.stripe.com/test/apikeys), commence par sk_test_.
# Si absente, le serveur démarre quand même mais les routes de paiement renvoient 503.
STRIPE_SECRET_KEY=

# Cloudinary — non utilisé en Phase 1
CLOUDINARY_URL=

# Frontend (CORS)
CLIENT_URL=http://localhost:5173
